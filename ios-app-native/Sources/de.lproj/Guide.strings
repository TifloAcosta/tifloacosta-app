/* Barrierefreies Benutzerhandbuch auf Deutsch. */
"guide.1.title" = "Aktuelles";
"guide.1.paragraph.1" = "Lies Nachrichten über Technik und Barrierefreiheit. Nutze die Kategorieauswahl oder die Suche, um ein Thema zu finden.";
"guide.1.paragraph.2" = "Du kannst Nachrichten, Podcasts und YouTube-Kanäle auswählen. Die Originalinhalte behalten ihre Sprache.";
"guide.1.paragraph.3" = "Öffne einen Artikel zum Lesen. Über die Bedienungshilfen kannst du ihn speichern, teilen, die Originalquelle öffnen und weitere Ergebnisse anzeigen.";
"guide.2.title" = "Ressourcen";
"guide.2.paragraph.1" = "Hier findest du Anleitungen und Materialien nach Kategorien. Mit VoiceOver wechselst du die Kategorie durch Wischen nach oben oder unten.";
"guide.2.paragraph.2" = "Öffne einen Titel, um die Ressource zu lesen, in TifloLector zu speichern, herunterzuladen oder zu teilen.";
"guide.2.paragraph.3" = "Beim Wechsel der Kategorie wird die Liste aktualisiert. Mit Zurück gelangst du zum vorherigen Bildschirm.";
"guide.3.title" = "TifloLector";
"guide.3.paragraph.1" = "Importiere Dokumente aus Dateien, verfügbaren Online-Bibliotheken oder über das Teilen-Menü anderer Apps.";
"guide.3.paragraph.2" = "Stelle Stimme, Geschwindigkeit und Darstellung ein. Organisiere Bücher mit Filtern, Sortierung, Ordnern und Mehrfachauswahl.";
"guide.3.paragraph.3" = "Öffne ein Buch aus der Bibliothek zum Lesen oder Anhören. Mit den Bedienungshilfen kannst du Informationen ansehen, das Dokument umbenennen, verschieben oder löschen.";
"guide.3.paragraph.4" = "Während des Lesens stehen Wiedergabe, Navigation, Fortschritt, Lesezeichen und Audioeinstellungen bereit. Einige Funktionen hängen vom Dateiformat ab.";
"guide.4.title" = "Empfangene Dateien";
"guide.4.paragraph.1" = "Hier erscheinen Dateien, die du aus anderen Apps mit TifloAcosta geteilt hast.";
"guide.4.paragraph.2" = "Wähle eine Datei und importiere sie in TifloLector. Öffne sie anschließend aus deiner Bibliothek.";
"guide.4.paragraph.3" = "Aktualisiere und verwalte die empfangenen Elemente. Falls eine Datei nicht erkannt wird, prüfe das Format und teile sie erneut.";
"guide.5.title" = "Neuigkeiten";
"guide.5.paragraph.1" = "Entdecke neue Ressourcen und Videos von TifloAcosta.";
"guide.5.paragraph.2" = "Öffne eine Ressource zum Lesen. Je nach Inhalt kannst du sie speichern, herunterladen, teilen oder zu den Favoriten hinzufügen.";
"guide.5.paragraph.3" = "Öffne oder teile neue Videos, ohne alle Kategorien durchsuchen zu müssen.";
"guide.6.title" = "Über einen Link herunterladen";
"guide.6.paragraph.1" = "Gib einen HTTPS-Link ein oder verwende Link einfügen, um eine Datei zu speichern.";
"guide.6.paragraph.2" = "Prüfe den Link vor dem Herunterladen. Manche Server erlauben die Prüfung erst während des Downloads.";
"guide.6.paragraph.3" = "Nach dem Herunterladen findest du die Datei unter Meine Downloads und kannst sie in TifloLector importieren.";
"guide.6.paragraph.4" = "Private oder zugriffsgeschützte Links können den direkten Download verhindern.";
"guide.7.title" = "Favoriten";
"guide.7.paragraph.1" = "Speichere Nachrichten, Ressourcen und Videos, um sie schnell wiederzufinden.";
"guide.7.paragraph.2" = "Öffne einen Favoriten oder entferne ihn aus der Liste, ohne den Originalinhalt zu löschen.";
"guide.7.paragraph.3" = "Falls ein Inhalt vorübergehend aus dem Katalog verschwindet, bleibt seine gespeicherte Referenz erhalten.";
"guide.8.title" = "Videos";
"guide.8.paragraph.1" = "Suche YouTube-Videos mit barrierefreien Steuerelementen oder öffne den TifloAcosta-Kanal.";
"guide.8.paragraph.2" = "Filtere die Ergebnisse nach Videos, Kanälen, Kurzvideos, Livestreams oder Untertiteln.";
"guide.8.paragraph.3" = "Spiele Videos im App-Player ab. Über die Bedienungshilfen kannst du Inhalte teilen oder in YouTube öffnen.";
"guide.8.paragraph.4" = "Melde dich bei Google nur für Funktionen an, die ein Konto benötigen, beispielsweise Abonnements.";
"guide.8.paragraph.5" = "Die Kanalliste lässt sich nach Datum sortieren und um weitere Videos erweitern.";
"guide.9.title" = "Podcasts";
"guide.9.paragraph.1" = "Durchsuche die Folgen des TifloAcosta-Podcasts, beginnend mit den neuesten.";
"guide.9.paragraph.2" = "Öffne eine Folge zum Anhören. Du kannst pausieren, fortsetzen sowie 30 Sekunden vor- oder zurückspringen.";
"guide.9.paragraph.3" = "Teile Folgen, aktualisiere die Liste oder besuche die verfügbaren externen Plattformen.";
"guide.10.title" = "Kontakt und soziale Netzwerke";
"guide.10.paragraph.1" = "Hier findest du Kontaktmöglichkeiten und Links zu YouTube, Instagram, Facebook und der offiziellen Website.";
"guide.10.paragraph.2" = "Unter Mein Buch erhältst du Informationen zum Werk La vida vista desde donde estoy.";
"guide.10.paragraph.3" = "Mit VoiceOver öffnest du einen Link durch Doppeltippen. Bei manchen Links ist auch Teilen möglich.";
"guide.11.title" = "Datenschutz und Barrierefreiheit";
"guide.11.paragraph.1" = "Informiere dich über Datenschutz und Barrierefreiheit der App.";
"guide.11.paragraph.2" = "Erfahre, wie Daten verarbeitet werden und welche Dienste die App nutzt. Externe Links können eigene Bedingungen haben.";
"guide.11.paragraph.3" = "Mit Zurück gelangst du zum Hauptbildschirm.";
"guide.12.title" = "Einstellungen";
"guide.12.paragraph.1" = "Wähle die App-Sprache aus Spanisch, Englisch, Portugiesisch, Französisch, Italienisch und Deutsch. Deine Auswahl wird gespeichert.";
"guide.12.paragraph.2" = "In den Anzeigeeinstellungen kannst du Kontrast, Textgröße, Zeilenabstand und verstärkten Text anpassen.";
"guide.12.paragraph.3" = "Hier findest du die installierte Version und die offizielle Website. Die Leseeinstellungen einzelner Dokumente werden in TifloLector verwaltet.";
