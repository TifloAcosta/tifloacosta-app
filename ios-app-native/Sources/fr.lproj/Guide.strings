/* Guide d’utilisation accessible en français. */
"guide.1.title" = "Actualités";
"guide.1.paragraph.1" = "Consulte les actualités sur la technologie et l’accessibilité. Utilise le sélecteur de catégorie ou la recherche pour trouver un sujet.";
"guide.1.paragraph.2" = "Tu peux choisir les actualités, les podcasts ou les chaînes YouTube. Les contenus d’origine conservent leur langue.";
"guide.1.paragraph.3" = "Ouvre un article pour le lire. Les actions d’accessibilité permettent de l’enregistrer, de le partager, d’ouvrir sa source ou de consulter plus de résultats.";
"guide.2.title" = "Ressources";
"guide.2.paragraph.1" = "Retrouve des guides et des documents classés par catégorie. Avec VoiceOver, change de catégorie en balayant vers le haut ou vers le bas.";
"guide.2.paragraph.2" = "Ouvre un titre pour lire, enregistrer dans TifloLector, télécharger ou partager selon les options disponibles.";
"guide.2.paragraph.3" = "En changeant de catégorie, la liste est actualisée. Utilise Retour pour revenir.";
"guide.3.title" = "TifloLector";
"guide.3.paragraph.1" = "Importe des documents depuis Fichiers, les bibliothèques disponibles ou le menu Partager d’autres applications.";
"guide.3.paragraph.2" = "Configure la voix, la vitesse et la présentation. Organise tes livres avec des filtres, un tri, des dossiers et la sélection multiple.";
"guide.3.paragraph.3" = "Ouvre un document de la bibliothèque pour lire ou écouter. Les actions accessibles permettent de consulter les informations, de renommer, déplacer ou supprimer le document.";
"guide.3.paragraph.4" = "Pendant la lecture, utilise les commandes de lecture, de navigation, de progression, les signets et les réglages audio. Certaines fonctions dépendent du format.";
"guide.4.title" = "Éléments reçus";
"guide.4.paragraph.1" = "Retrouve ici les fichiers envoyés à TifloAcosta depuis d’autres applications.";
"guide.4.paragraph.2" = "Sélectionne un fichier et importe-le dans TifloLector, puis ouvre-le depuis ta bibliothèque.";
"guide.4.paragraph.3" = "Actualise et gère les éléments reçus. Si un fichier n’est pas reconnu, vérifie son format et partage-le à nouveau.";
"guide.5.title" = "Nouveautés";
"guide.5.paragraph.1" = "Découvre les ressources et les vidéos récemment publiées par TifloAcosta.";
"guide.5.paragraph.2" = "Ouvre une ressource pour la lire. Selon le contenu, tu peux enregistrer, télécharger, partager ou ajouter aux favoris.";
"guide.5.paragraph.3" = "Ouvre ou partage les nouvelles vidéos sans parcourir toutes les catégories.";
"guide.6.title" = "Télécharger depuis un lien";
"guide.6.paragraph.1" = "Saisis un lien HTTPS ou utilise Coller le lien pour enregistrer un fichier.";
"guide.6.paragraph.2" = "Analyse le lien avant le téléchargement. Certains serveurs ne permettent la vérification que pendant le téléchargement.";
"guide.6.paragraph.3" = "Après le téléchargement, retrouve le fichier dans Mes téléchargements et importe-le dans TifloLector.";
"guide.6.paragraph.4" = "Les liens privés ou protégés par des autorisations peuvent empêcher le téléchargement direct.";
"guide.7.title" = "Favoris";
"guide.7.paragraph.1" = "Conserve tes actualités, ressources et vidéos favorites pour les retrouver facilement.";
"guide.7.paragraph.2" = "Ouvre un favori ou retire-le de la liste sans supprimer le contenu d’origine.";
"guide.7.paragraph.3" = "Si un contenu disparaît temporairement du catalogue, sa référence enregistrée est conservée.";
"guide.8.title" = "Vidéos";
"guide.8.paragraph.1" = "Recherche des vidéos YouTube avec des commandes accessibles ou consulte la chaîne TifloAcosta.";
"guide.8.paragraph.2" = "Filtre les résultats par vidéos, chaînes, formats courts, directs ou sous-titres.";
"guide.8.paragraph.3" = "Lis les résultats dans le lecteur de l’application. Les actions d’accessibilité permettent de partager ou d’ouvrir YouTube.";
"guide.8.paragraph.4" = "Connecte-toi avec Google uniquement pour les fonctions qui nécessitent un compte, comme les abonnements.";
"guide.8.paragraph.5" = "La liste des vidéos de la chaîne peut être triée par date et afficher davantage de résultats.";
"guide.9.title" = "Podcasts";
"guide.9.paragraph.1" = "Consulte les épisodes du podcast TifloAcosta, en commençant par les plus récents.";
"guide.9.paragraph.2" = "Ouvre un épisode pour l’écouter. Tu peux mettre en pause, reprendre et avancer ou reculer de 30 secondes.";
"guide.9.paragraph.3" = "Partage les épisodes, actualise la liste ou consulte les plateformes externes disponibles.";
"guide.10.title" = "Contact et réseaux sociaux";
"guide.10.paragraph.1" = "Retrouve les coordonnées et les liens vers YouTube, Instagram, Facebook et le site officiel.";
"guide.10.paragraph.2" = "La rubrique Mon livre présente l’ouvrage La vida vista desde donde estoy.";
"guide.10.paragraph.3" = "Avec VoiceOver, touche deux fois pour ouvrir un lien ; certains liens permettent aussi le partage.";
"guide.11.title" = "Confidentialité et accessibilité";
"guide.11.paragraph.1" = "Consulte les informations sur la confidentialité et l’accessibilité de l’application.";
"guide.11.paragraph.2" = "Vérifie comment les données sont traitées et quels services sont utilisés. Les liens externes peuvent avoir leurs propres conditions.";
"guide.11.paragraph.3" = "Utilise Retour pour revenir à l’écran principal.";
"guide.12.title" = "Paramètres";
"guide.12.paragraph.1" = "Choisis la langue de l’application parmi l’espagnol, l’anglais, le portugais, le français, l’italien et l’allemand. Ce choix est conservé.";
"guide.12.paragraph.2" = "Ouvre les réglages d’affichage pour ajuster le contraste, la taille du texte, l’interligne et le renforcement du texte.";
"guide.12.paragraph.3" = "Consulte la version installée et le site officiel. Les préférences de lecture propres à chaque document se trouvent dans TifloLector.";
