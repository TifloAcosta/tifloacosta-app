/* Guida accessibile in italiano. */
"guide.1.title" = "Attualità";
"guide.1.paragraph.1" = "Consulta notizie su tecnologia e accessibilità. Usa il selettore delle categorie o la ricerca per trovare un argomento.";
"guide.1.paragraph.2" = "Puoi scegliere tra notizie, podcast e canali YouTube. I contenuti originali mantengono la propria lingua.";
"guide.1.paragraph.3" = "Apri un articolo per leggerlo. Le azioni di accessibilità permettono di salvarlo, condividerlo, aprire la fonte originale e vedere altri risultati.";
"guide.2.title" = "Risorse";
"guide.2.paragraph.1" = "Trova guide e materiali suddivisi per categoria. Con VoiceOver scorri in alto o in basso per cambiare categoria.";
"guide.2.paragraph.2" = "Apri un titolo per leggerlo, salvarlo in TifloLector, scaricarlo o condividerlo, secondo le opzioni disponibili.";
"guide.2.paragraph.3" = "Quando cambi categoria, l’elenco viene aggiornato. Usa Indietro per tornare.";
"guide.3.title" = "TifloLector";
"guide.3.paragraph.1" = "Importa documenti da File, dalle biblioteche disponibili oppure tramite il menu Condividi di altre applicazioni.";
"guide.3.paragraph.2" = "Configura voce, velocità e visualizzazione. Organizza i libri con filtri, ordinamento, cartelle e selezione multipla.";
"guide.3.paragraph.3" = "Apri un libro dalla biblioteca per leggere o ascoltare. Le azioni accessibili consentono di vedere informazioni, rinominare, spostare o eliminare il documento.";
"guide.3.paragraph.4" = "Durante la lettura, usa i controlli di riproduzione, navigazione, avanzamento, i segnalibri e le impostazioni audio. Alcune funzioni dipendono dal formato.";
"guide.4.title" = "Elementi ricevuti";
"guide.4.paragraph.1" = "Qui trovi i file condivisi con TifloAcosta da altre applicazioni.";
"guide.4.paragraph.2" = "Seleziona un file e importalo in TifloLector, poi aprilo dalla biblioteca.";
"guide.4.paragraph.3" = "Aggiorna e gestisci gli elementi ricevuti. Se un file non viene riconosciuto, controlla il formato e condividilo di nuovo.";
"guide.5.title" = "Novità";
"guide.5.paragraph.1" = "Scopri le nuove risorse e i video pubblicati da TifloAcosta.";
"guide.5.paragraph.2" = "Apri una risorsa per leggerla. In base al contenuto puoi salvare, scaricare, condividere o aggiungere ai preferiti.";
"guide.5.paragraph.3" = "Apri o condividi i nuovi video senza scorrere tutte le categorie.";
"guide.6.title" = "Scarica da un link";
"guide.6.paragraph.1" = "Inserisci un link HTTPS o scegli Incolla link per salvare un file.";
"guide.6.paragraph.2" = "Analizza il link prima di scaricare. Alcuni server permettono la verifica solo durante il download.";
"guide.6.paragraph.3" = "Dopo il download, trova il file in I miei download e importalo in TifloLector.";
"guide.6.paragraph.4" = "I link privati o protetti da autorizzazioni potrebbero impedire il download diretto.";
"guide.7.title" = "Preferiti";
"guide.7.paragraph.1" = "Salva notizie, risorse e video preferiti per ritrovarli facilmente.";
"guide.7.paragraph.2" = "Apri un preferito oppure rimuovilo dall’elenco senza eliminare il contenuto originale.";
"guide.7.paragraph.3" = "Se un contenuto scompare temporaneamente dal catalogo, il riferimento salvato viene conservato.";
"guide.8.title" = "Video";
"guide.8.paragraph.1" = "Cerca video su YouTube con controlli accessibili oppure visita il canale TifloAcosta.";
"guide.8.paragraph.2" = "Filtra i risultati per video, canali, video brevi, dirette o sottotitoli.";
"guide.8.paragraph.3" = "Riproduci i risultati nel lettore dell’app. Le azioni di accessibilità permettono di condividere o aprire YouTube.";
"guide.8.paragraph.4" = "Accedi con Google solo per le funzioni che richiedono un account, come le iscrizioni.";
"guide.8.paragraph.5" = "L’elenco dei video del canale può essere ordinato per data e mostrare altri risultati.";
"guide.9.title" = "Podcast";
"guide.9.paragraph.1" = "Consulta gli episodi del podcast TifloAcosta, partendo dai più recenti.";
"guide.9.paragraph.2" = "Apri un episodio per ascoltarlo. Puoi mettere in pausa, riprendere, avanzare o tornare indietro di 30 secondi.";
"guide.9.paragraph.3" = "Condividi gli episodi, aggiorna l’elenco oppure visita le piattaforme esterne disponibili.";
"guide.10.title" = "Contatti e social network";
"guide.10.paragraph.1" = "Trova i contatti e i link a YouTube, Instagram, Facebook e al sito ufficiale.";
"guide.10.paragraph.2" = "La sezione Il mio libro presenta l’opera La vida vista desde donde estoy.";
"guide.10.paragraph.3" = "Con VoiceOver esegui un doppio tocco per aprire un link; alcuni link consentono anche la condivisione.";
"guide.11.title" = "Privacy e accessibilità";
"guide.11.paragraph.1" = "Consulta le informazioni sulla privacy e sull’accessibilità dell’app.";
"guide.11.paragraph.2" = "Scopri come vengono trattati i dati e quali servizi vengono utilizzati. I link esterni possono avere condizioni proprie.";
"guide.11.paragraph.3" = "Usa Indietro per tornare alla schermata principale.";
"guide.12.title" = "Impostazioni";
"guide.12.paragraph.1" = "Scegli la lingua dell’app tra spagnolo, inglese, portoghese, francese, italiano e tedesco. La scelta viene memorizzata.";
"guide.12.paragraph.2" = "Apri le impostazioni visive per regolare contrasto, dimensione del testo, interlinea e testo in grassetto.";
"guide.12.paragraph.3" = "Controlla la versione installata e il sito ufficiale. Le preferenze di lettura dei singoli documenti si trovano in TifloLector.";
