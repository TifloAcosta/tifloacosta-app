/* Guia de utilização localizado para português. */
"guide.1.title" = "Atualidade";
"guide.1.paragraph.1" = "Consulta notícias sobre tecnologia e acessibilidade. Usa o seletor de categorias ou a pesquisa para encontrares um tema.";
"guide.1.paragraph.2" = "Podes alternar entre notícias, podcasts e canais de YouTube. O conteúdo original mantém o seu idioma.";
"guide.1.paragraph.3" = "Abre uma notícia para a ler. As ações de acessibilidade permitem guardar, partilhar, abrir a fonte original e consultar mais resultados.";
"guide.2.title" = "Recursos";
"guide.2.paragraph.1" = "Encontra guias e materiais organizados por categoria. Com o VoiceOver, ajusta a categoria deslizando para cima ou para baixo.";
"guide.2.paragraph.2" = "Abre um título para ler, guardar no TifloLector, transferir ou partilhar, conforme as opções disponíveis.";
"guide.2.paragraph.3" = "Ao mudar de categoria, a lista é atualizada. Usa Voltar para regressar.";
"guide.3.title" = "TifloLector";
"guide.3.paragraph.1" = "Importa documentos da aplicação Ficheiros, das bibliotecas disponíveis ou através da opção Partilhar de outras aplicações.";
"guide.3.paragraph.2" = "Configura a voz, a velocidade e a apresentação. Organiza os livros com filtros, ordenação, pastas e seleção múltipla.";
"guide.3.paragraph.3" = "Abre uma obra na biblioteca para a ler ou reproduzir. As ações acessíveis permitem consultar informações, alterar o título e mover ou eliminar o documento.";
"guide.3.paragraph.4" = "Na leitura, utiliza os controlos de reprodução, navegação e progresso, os marcadores e as definições de áudio. As funções dependem do formato.";
"guide.4.title" = "Recebidos";
"guide.4.paragraph.1" = "Aqui encontras os ficheiros partilhados com o TifloAcosta a partir de outras aplicações.";
"guide.4.paragraph.2" = "Seleciona um ficheiro e importa-o para o TifloLector; depois abre-o na tua biblioteca.";
"guide.4.paragraph.3" = "Atualiza e gere os itens recebidos. Se um ficheiro não for reconhecido, verifica o formato e tenta partilhá-lo novamente.";
"guide.5.title" = "Novidades";
"guide.5.paragraph.1" = "Consulta os novos recursos e vídeos publicados pelo TifloAcosta.";
"guide.5.paragraph.2" = "Abre um recurso para o ler. Dependendo do conteúdo, podes guardar, transferir, partilhar ou adicionar aos favoritos.";
"guide.5.paragraph.3" = "Abre ou partilha os novos vídeos sem percorrer todas as categorias.";
"guide.6.title" = "Transferir a partir de uma ligação";
"guide.6.paragraph.1" = "Introduz uma ligação HTTPS ou utiliza Colar ligação para guardar um ficheiro.";
"guide.6.paragraph.2" = "Analisa a ligação antes de transferir. Alguns servidores só permitem verificar o acesso durante a transferência.";
"guide.6.paragraph.3" = "Depois da transferência, procura o ficheiro em As minhas transferências e importa-o para o TifloLector.";
"guide.6.paragraph.4" = "As ligações privadas ou protegidas por permissões podem não permitir a transferência direta.";
"guide.7.title" = "Favoritos";
"guide.7.paragraph.1" = "Guarda notícias, recursos e vídeos para os encontrares rapidamente.";
"guide.7.paragraph.2" = "Abre um favorito ou remove-o da lista sem eliminar o conteúdo original.";
"guide.7.paragraph.3" = "Se o conteúdo desaparecer temporariamente do catálogo, a referência guardada é mantida.";
"guide.8.title" = "Vídeos";
"guide.8.paragraph.1" = "Pesquisa vídeos no YouTube com controlos acessíveis ou consulta o canal TifloAcosta.";
"guide.8.paragraph.2" = "Filtra os resultados por vídeos, canais, vídeos curtos, transmissões em direto ou legendas.";
"guide.8.paragraph.3" = "Reproduz os resultados no leitor da aplicação e utiliza as ações de acessibilidade para partilhar ou abrir no YouTube.";
"guide.8.paragraph.4" = "Inicia sessão no Google apenas para as funcionalidades que exigem uma conta, como as subscrições.";
"guide.8.paragraph.5" = "A lista do canal pode ser ordenada por data e apresentar mais vídeos.";
"guide.9.title" = "Podcasts";
"guide.9.paragraph.1" = "Consulta os episódios do podcast TifloAcosta, começando pelos mais recentes.";
"guide.9.paragraph.2" = "Abre um episódio para ouvir. Podes pausar, retomar e avançar ou recuar 30 segundos.";
"guide.9.paragraph.3" = "Partilha episódios, atualiza a lista ou visita as plataformas externas disponíveis.";
"guide.10.title" = "Contacto e redes sociais";
"guide.10.paragraph.1" = "Encontra os contactos e as ligações ao YouTube, Instagram, Facebook e ao site oficial.";
"guide.10.paragraph.2" = "A secção O meu livro apresenta informações sobre a obra La vida vista desde donde estoy.";
"guide.10.paragraph.3" = "Com o VoiceOver, toca duas vezes para abrir uma ligação; algumas também permitem partilhar.";
"guide.11.title" = "Privacidade e acessibilidade";
"guide.11.paragraph.1" = "Consulta as informações de privacidade e acessibilidade da aplicação.";
"guide.11.paragraph.2" = "Verifica como os dados são tratados e quais os serviços utilizados. As ligações externas podem ter condições próprias.";
"guide.11.paragraph.3" = "Usa Voltar para regressar ao ecrã principal.";
"guide.12.title" = "Definições";
"guide.12.paragraph.1" = "Escolhe o idioma da aplicação entre espanhol, inglês, português, francês, italiano e alemão. A preferência fica guardada.";
"guide.12.paragraph.2" = "Abre as definições visuais para ajustar contraste, tamanho do texto, espaçamento e reforço das letras.";
"guide.12.paragraph.3" = "Consulta a versão instalada e o site oficial. As preferências de leitura de cada obra ficam no TifloLector.";
